{
  "name": "codabridge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts && node scripts/finish-build.mjs",
    "lint": "oxlint",
    "preview": "WRANGLER_SEND_METRICS=false wrangler dev --local --config wrangler.local.json --ip 127.0.0.1 --port 4173 --log-level error --show-interactive-dev-session=false",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "data:verify": "node --experimental-strip-types scripts/prepare-data.ts --check && node --experimental-strip-types scripts/prepare-context.ts --check",
    "data:prepare": "node --experimental-strip-types scripts/prepare-data.ts",
    "test:server-build": "node --experimental-strip-types --test tests/artifact/*.test.ts",
    "analysis:prepare": "node --experimental-strip-types scripts/prepare-prediction.ts",
    "analysis:test": "analysis/dialogue-transfer/.venv/bin/python -m unittest discover -s analysis/dialogue-transfer -p 'test_*.py' -v",
    "analysis:run": "analysis/dialogue-transfer/.venv/bin/python analysis/dialogue-transfer/run.py",
    "analysis:reproduce": "analysis/dialogue-transfer/.venv/bin/python analysis/dialogue-transfer/run.py --check",
    "analysis:verify": "node --experimental-strip-types scripts/prepare-prediction.ts --check && node --experimental-strip-types analysis/dialogue-transfer/verify.ts && node --experimental-strip-types scripts/check-prediction-summary.ts",
    "analysis:v02:prepare": "node --experimental-strip-types scripts/prepare-prediction-v02.ts",
    "analysis:v02:test": "analysis/dialogue-transfer/.venv/bin/python -m unittest discover -s analysis/dialogue-transfer-v02 -p 'test_*.py' -v",
    "analysis:v02:run": "analysis/dialogue-transfer/.venv/bin/python analysis/dialogue-transfer-v02/run.py",
    "analysis:v02:verify": "node --experimental-strip-types scripts/prepare-prediction-v02.ts --check && node --experimental-strip-types analysis/dialogue-transfer-v02/verify.ts",
    "analysis:v02:reproduce": "analysis/dialogue-transfer/.venv/bin/python analysis/dialogue-transfer-v02/run.py --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
